{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mystand.query-tool.v1",
  "tool": {
    "name": "mystand_query",
    "description": "Read facts from the current user's authorized My Stand data. Use the semantic resource/entity shape for an identified material. For finance-ledger questions that require rank, list, predicate, count, or a year/month settlement-card unconfirmed list, use the matching strict finance aggregate shape shown in this schema. Call once and answer only from its result. Identity, ownership, authorization IDs, resource IDs, source IDs, lookup steps, query text, and fields outside the selected shape must never be supplied or narrated.",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "operation": {
          "const": "read",
          "type": "string"
        },
        "query_kind": {
          "enum": ["rank", "list", "predicate", "count"],
          "type": "string"
        },
        "module_id": {
          "const": "finance-ledger",
          "type": "string"
        },
        "fact_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "finance.performance.rank",
              "finance.performance.list",
              "finance.performance.predicate",
              "finance.performance.count",
              "finance.settlement_confirmation.unconfirmed"
            ],
            "type": "string"
          }
        },
        "query_args": {
          "type": "object"
        },
        "coverage_required": {
          "const": true,
          "type": "boolean"
        },
        "resource": {
          "type": "object",
          "properties": {
            "name": {
              "minLength": 2,
              "maxLength": 240,
              "type": "string"
            },
            "type_hint": {
              "enum": [
                "note",
                "knowledge-markdown",
                "knowledge-graph",
                "property-note",
                "business-archive",
                "profile-card",
                "property-data",
                "property-md",
                "finance-archive"
              ],
              "type": "string"
            }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "entities": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "building",
                  "unit",
                "room",
                "person",
                "estate",
                "document",
                "topic",
                "time"
                ],
                "type": "string"
              },
              "value": {
                "minLength": 1,
                "maxLength": 160,
                "type": "string"
              },
              "role": {
                "enum": [
                  "resource",
                  "locator",
                  "subject",
                  "time",
                  "topic",
                  "attribute"
                ],
                "type": "string"
              }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          }
        },
        "fact_needs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "owner.name",
              "owner.phone",
              "owner.family",
              "owner.interests",
              "owner.economic",
              "relationship.communication",
              "relationship.followup",
              "property.parking",
              "property.area",
              "property.price.total",
              "property.price.unit",
              "property.rent",
              "document.content",
              "resource.summary",
              "graph.nodes",
              "graph.relations"
            ],
            "type": "string"
          }
        },
        "mode": {
          "enum": ["facts", "summary"],
          "type": "string",
          "default": "facts"
        }
      },
      "required": ["operation"],
      "anyOf": [
        {
          "required": ["resource", "fact_needs"]
        },
        {
          "required": ["entities", "fact_needs"],
          "properties": {
            "entities": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "query_kind",
            "module_id",
            "fact_paths",
            "query_args",
            "coverage_required"
          ],
          "properties": {
            "query_kind": {
              "const": "list"
            },
            "fact_paths": {
              "const": ["finance.performance.list"]
            },
            "query_args": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2100
                }
              },
              "required": ["year"],
              "additionalProperties": false
            }
          }
        },
        {
          "required": [
            "query_kind",
            "module_id",
            "fact_paths",
            "query_args",
            "coverage_required"
          ],
          "properties": {
            "query_kind": {
              "const": "list"
            },
            "fact_paths": {
              "const": ["finance.settlement_confirmation.unconfirmed"]
            },
            "query_args": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2100
                },
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                }
              },
              "required": ["year", "month"],
              "additionalProperties": false
            }
          }
        },
        {
          "required": [
            "query_kind",
            "module_id",
            "fact_paths",
            "query_args",
            "coverage_required"
          ],
          "properties": {
            "query_kind": {
              "const": "rank"
            },
            "fact_paths": {
              "const": ["finance.performance.rank"]
            },
            "query_args": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2100
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": ["year", "rank"],
              "additionalProperties": false
            }
          }
        },
        {
          "required": [
            "query_kind",
            "module_id",
            "fact_paths",
            "query_args",
            "coverage_required"
          ],
          "properties": {
            "query_kind": {
              "const": "predicate"
            },
            "fact_paths": {
              "const": ["finance.performance.predicate"]
            },
            "query_args": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2100
                },
                "field": {
                  "const": "yearlyAmount",
                  "type": "string"
                },
                "operator": {
                  "enum": ["gt", "gte"],
                  "type": "string"
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["year", "field", "operator", "amount"],
              "additionalProperties": false
            }
          }
        },
        {
          "required": [
            "query_kind",
            "module_id",
            "fact_paths",
            "query_args",
            "coverage_required"
          ],
          "properties": {
            "query_kind": {
              "const": "count"
            },
            "fact_paths": {
              "const": ["finance.performance.count"]
            },
            "query_args": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2100
                },
                "field": {
                  "const": "yearlyAmount",
                  "type": "string"
                },
                "operator": {
                  "enum": ["gt", "gte"],
                  "type": "string"
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["year", "field", "operator", "amount"],
              "additionalProperties": false
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "content": {
        "type": "string"
      },
      "facts": {
        "type": "array"
      },
      "coverage": {
        "type": "object"
      },
      "recordRefs": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["ok"],
    "additionalProperties": true
  }
}
