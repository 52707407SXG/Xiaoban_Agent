{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mystand.query-tool.v1",
  "tool": {
    "name": "mystand_query",
    "description": "Read facts from the current user's authorized My Stand data. Understand the latest request as a whole, then create one semantic plan: when the user identified a material, use its estate, person, document, or other subject as a human-readable resource anchor; otherwise omit resource and provide the known subject entities. Infer the data kind only when clear and request only the needed fact categories. Do not route from isolated keywords and do not invent an exact backend module or stored title. The server follows the real index and entity relationships. Call this tool once, then answer only from its compact result. Identity, ownership, resource IDs, authorization IDs, source IDs, lookup steps, and queryText are trusted backend concerns and must never be supplied or narrated.",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "operation": {
          "const": "read",
          "type": "string"
        },
        "query_kind": {
          "enum": ["resource-read", "rank", "predicate", "count", "list", "aggregate"],
          "type": "string"
        },
        "module_id": {
          "maxLength": 80,
          "type": "string"
        },
        "fact_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{1,119}$",
            "type": "string"
          }
        },
        "query_args": {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": true
        },
        "coverage_required": {
          "type": "boolean"
        },
        "resource": {
          "type": "object",
          "properties": {
            "name": {
              "minLength": 2,
              "maxLength": 240,
              "type": "string"
            },
            "type_hint": {
              "enum": [
                "note",
                "knowledge-markdown",
                "knowledge-graph",
                "property-note",
                "business-archive",
                "profile-card",
                "property-data",
                "property-md",
                "finance-archive"
              ],
              "type": "string"
            }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "entities": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "building",
                  "unit",
                "room",
                "person",
                "estate",
                "document",
                "topic",
                "time"
                ],
                "type": "string"
              },
              "value": {
                "minLength": 1,
                "maxLength": 160,
                "type": "string"
              },
              "role": {
                "enum": [
                  "resource",
                  "locator",
                  "subject",
                  "time",
                  "topic",
                  "attribute"
                ],
                "type": "string"
              }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          }
        },
        "fact_needs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "owner.name",
              "owner.phone",
              "owner.family",
              "owner.interests",
              "owner.economic",
              "relationship.communication",
              "relationship.followup",
              "property.parking",
              "property.area",
              "property.price.total",
              "property.price.unit",
              "property.rent",
              "document.content",
              "resource.summary",
              "graph.nodes",
              "graph.relations"
            ],
            "type": "string"
          }
        },
        "mode": {
          "enum": ["facts", "summary"],
          "type": "string",
          "default": "facts"
        }
      },
      "required": ["operation"],
      "anyOf": [
        {
          "required": ["resource", "fact_needs"]
        },
        {
          "required": ["entities", "fact_needs"],
          "properties": {
            "entities": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "query_kind",
            "module_id",
            "fact_paths",
            "query_args",
            "coverage_required"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "content": {
        "type": "string"
      },
      "facts": {
        "type": "array"
      },
      "coverage": {
        "type": "object"
      },
      "recordRefs": {
        "type": "array",
        "items": { "type": "string" }
      },
      "requirementDigest": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      }
    },
    "required": ["ok"],
    "additionalProperties": true
  }
}
